model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-ES
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["TipHoras","CipHoras","Trabajadores","HORASOK","Contratos","HORASOK W17"]

annotation PBI_ProTooling = ["DevMode"]

ref table TipHoras
ref table CipHoras
ref table Calendario
ref table Trabajadores
ref table HORASOK
ref table Contratos
ref table 'HORASOK W17'

ref cultureInfo es-ES

