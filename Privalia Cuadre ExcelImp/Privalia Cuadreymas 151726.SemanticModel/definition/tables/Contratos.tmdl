table Contratos
	lineageTag: a8423541-d704-4b55-b0e7-73494e52e828

	measure Asignaciones = ```
			
			    CALCULATE (
			        COUNTROWS ( Contratos ),
			        FILTER ( ALL ( contratos[ctfechaini] ), Contratos[ctfechaini] <= [fecfin] ),
			        FILTER (
			            ALL ( contratos[ctfechafinreal] ),
			            ISBLANK ( Contratos[ctfechafinreal] ) = TRUE ()
			                || Contratos[ctfechafinreal] >= [fecini]
			        )
			    )
			```
		formatString: 0
		lineageTag: 3a3bc2f5-3c50-439a-917c-3956587fb363

	column ctcontrato
		dataType: int64
		formatString: 0
		lineageTag: 1c27b205-7fe9-45bd-9a43-89bb8a2b5007
		summarizeBy: sum
		sourceColumn: ctcontrato

		annotation SummarizationSetBy = Automatic

	column cttrabajador
		dataType: int64
		formatString: 0
		lineageTag: 8c7916d5-ece4-4200-9e3e-5f9eb5602fdb
		summarizeBy: none
		sourceColumn: cttrabajador

		annotation SummarizationSetBy = Automatic

