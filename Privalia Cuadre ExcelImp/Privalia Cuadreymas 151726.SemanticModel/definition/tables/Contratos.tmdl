	column trnif
		dataType: string
		lineageTag: 84ae1a71-805a-4d2f-8c3e-b44a1a1b5cdb
		summarizeBy: none
		sourceColumn: trnif

		annotation SummarizationSetBy = Automatic

	partition Contratos = m
		mode: import
		source =
				let
				    Origen = Sql.Database("10.10.138.5\temporing", "no3001", [Query="select ctcontrato,cttrabajador,trnif,ctfechaini,ctfechafinreal#(lf)from contra inner join#(lf)#(tab)clientes on contra.ctempresa=clientes.clempresa and contra.ctcentro=clientes.clcentro and contra.ctcliente=clientes.clcodigo inner join#(lf)#(tab)trabajador on ctempresa=trempresa and cttrabajador=trtrabajador#(lf)where contra.ctempresa=1#(lf)and ctcentro=09#(lf)and ctcliente=90318#(lf)and ((contra.ctfechafinreal is null) or year(contra.ctfechafinreal)>=2025)#(lf)and clientes.clnombre not like '%fijo%'"]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"ctfechaini", type date}, {"ctfechafinreal", type date}})
				in
				    #"Tipo cambiado"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

