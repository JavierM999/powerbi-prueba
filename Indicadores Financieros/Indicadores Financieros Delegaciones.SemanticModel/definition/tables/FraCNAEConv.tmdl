		formatString: #,0.00
		lineageTag: 2f0541bc-708e-4e19-895c-e9308fdc304b

		changedProperty = FormatString

	measure RankCNAE = IF(HASONEVALUE('CNAE 2Dig'[cna2d]),IF([TotFra]>0,RANKX(all('CNAE 2Dig'),[TotFra]),BLANK()))
		formatString: 0
		lineageTag: fcb45590-af74-483f-aa2a-3229f57facf2

	measure 'Top N FraCnae' = ```
			
			VAR TopnSele = SELECTEDVALUE('TopN Selecc'[Value])
			VAR TopCnaetabla = 
			 TOPN(
			            TopnSele,
			            ALLSELECTED('Pseu CNAE2'),
			            [TotFra]
			 )
			 VAR TopCnaeVta =
			CALCULATE(
			    [TotFra],
			    KEEPFILTERS(
			        TopCnaetabla
			        )
			    )
			VAR OtrasVta =
			CALCULATE(
			    [TotFra],
			    ALLSELECTED('Pseu CNAE2')
			) -
			CALCULATE(
			    [TotFra],
			    TopCnaetabla
			)
			VAR CnaeAct = SELECTEDVALUE('Pseu CNAE2'[Nombre])
			Return 
			IF(
			    CnaeAct<>"Otros",
			    TopCnaeVta,
			    OtrasVta
			)
			```
		lineageTag: 4e626da8-5525-42ba-8121-a56560084018

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Rank =
			
			IF(
			    [Top N FraCnae]<>BLANK(),
			    RANKX(
			        TOPN(
			            SELECTEDVALUE('TopN Selecc'[Value]),
			            ALLSELECTED('Pseu CNAE2'),
			            [TotFra]
			        ),
			        [TotFra],,DESC,Dense
			        )
			)
		formatString: 0
		lineageTag: d515c53b-d48c-4e86-a5b5-ca6d75247437

	measure Rank2 = ```
			
			    RANKX(
			        TOPN(
			            SELECTEDVALUE('TopN Selecc'[Value]),
			            ALLSELECTED('Pseu CNAE2'),
			            [TotFra]
			        ),
			        [TotFra],,DESC,Dense
			        )
			```
		formatString: 0
		lineageTag: ae76e292-373c-41ea-ab13-e4cfe04051a5

	measure titulo = ```
			
			VAR TopCnae = 
			    CALCULATE(
			        [TotFra],
			        TOPN(
			            SELECTEDVALUE('TopN Selecc'[Value]),
			            ALLSELECTED('Pseu CNAE2'[Nombre]),
			            [TotFra]
			        )
			    )
			VAR TopCnaepc = 
			    DIVIDE(TopCnae,[TotFra])
			REturn 
			"Top " & SELECTEDVALUE('TopN Selecc'[Value]) & " CNAE'S " & FORMAT(TopCnaepc,"#,#% Fra")
			            
			```
		lineageTag: 1fa27494-b1e7-4fac-99cc-70ab6da1b0d3

	measure Color =
			
			SWITCH(
			    SELECTEDVALUE('Pseu Clientes'[clnombre]),
			    "Otros","#D9D9D9",
			    "#ED7D31"
			)
		lineageTag: 5606a1ec-3044-45e5-80c2-93af27fe35b3

