	measure AcumFra1N = IF(HASONEFILTER('Agrupación'[Agrupación]),SUMX(TOPN([RankFraCnae],ALL('Agrupación'[Agrupación],'Agrupación'[Sectores de Actividad]),[Fra.Año Act.]),[Fra.Año Act.]),BLANK())
		lineageTag: 5447f424-6b71-404d-a303-aebf32af2f1d

