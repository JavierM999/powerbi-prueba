	measure CtaSem = ```
			
			VAR fechai = 
			    IF(max(Contratos[ctfechaini])<[fecini],[fecini],MAX(Contratos[ctfechaini]))
			VAR fechaf = 
			    IF(ISBLANK(MAX(Contratos[ctfechafinreal]))=TRUE() || MAX(Contratos[ctfechafinreal])>=[fecfin],[fecfin],MAX(Contratos[ctfechafinreal]))
			return DIVIDE(DATEDIFF(fechai,fechaf,DAY),7)
			```
		formatString: 0.00
		lineageTag: 27d7ed77-5ac2-4f09-a071-acc9c454a353

		changedProperty = FormatString

	measure TotHoras = CALCULATE([CtaSem]*MAX(Contratos[cthorassemana]))
