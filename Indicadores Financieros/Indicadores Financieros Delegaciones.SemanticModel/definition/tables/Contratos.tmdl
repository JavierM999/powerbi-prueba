	measure 'Horas Realizadas AAnt' =
			
			VAR result = sumx (
			    CALCULATETABLE(
			      ADDCOLUMNS(
			        SUMMARIZE(Contratos,Contratos[ctcentro],Contratos[ctcliente],Contratos[ctcontrato],Contratos[cthorassemana],Contratos[ctfechaini],Contratos[ctfechafinreal]),
			    "fini",IF(Contratos[ctfechaini]<[feciniaa],[feciniaa],Contratos[ctfechaini]),
			    "ffin",IF(ISBLANK(Contratos[ctfechafinreal])=TRUE() || Contratos[ctfechafinreal]>=[fecfinañan],[fecfinañan],Contratos[ctfechafinreal])),
			    FILTER(Contratos,Contratos[ctfechaini]<=[fecfinañan]),FILTER(Contratos,  ISBLANK(Contratos[ctfechafinreal])=TRUE() || Contratos[ctfechafinreal]>=[feciniaa])),
			        DIVIDE((DATEDIFF([fini],[ffin],DAY)+1),7)*Contratos[cthorassemana])
			RETURN result
		formatString: #,0.00
		lineageTag: ae14ad56-272d-4c3b-a121-631b34a1f864

		changedProperty = FormatString

