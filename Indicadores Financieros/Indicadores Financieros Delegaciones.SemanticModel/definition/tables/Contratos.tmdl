		changedProperty = FormatString

	measure Larefin = ```
			
			VAR fechai = 
			    IF(max(Contratos[ctfechaini])<[fecini],[fecini],MAX(Contratos[ctfechaini]))
			VAR fechaf = 
			    IF(ISBLANK(MAX(Contratos[ctfechafinreal]))=TRUE() || MAX(Contratos[ctfechafinreal])>=[fecfin],[fecfin],MAX(Contratos[ctfechafinreal]))
			VAR semanas = DIVIDE(DATEDIFF(fechai,fechaf,DAY),7)
			VAR result = sumx (
			    ADDCOLUMNS(
			    SUMMARIZE(Contratos,Contratos[ctcentro],Contratos[ctcontrato],Contratos[cthorassemana]),
			    "fini",fechai,
			    "ffin",fechaf,
			    "aver",Contratos[cthorassemana]*semanas),
			        [aver])
			RETURN result
			```
		lineageTag: 604960a1-63d6-4570-ba28-88c58942746f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

