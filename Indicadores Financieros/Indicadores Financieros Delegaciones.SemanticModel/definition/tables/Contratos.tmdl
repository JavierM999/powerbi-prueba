	measure 'Horas Realizadas' = ```
			
			VAR result =
			    SUMX (
			        CALCULATETABLE (
			            ADDCOLUMNS (
			                SUMMARIZE (
			                    Contratos,
			                    Contratos[ctcentro],
			                    Contratos[ctcliente],
			                    Contratos[ctcontrato],
			                    Contratos[cthorassemana],
			                    Contratos[ctfechaini],
			                    Contratos[ctfechafinreal]
			                ),
			                "fini", IF ( Contratos[ctfechaini] < [fecini], [fecini], Contratos[ctfechaini] ),
			                "ffin",
			                    IF (
			                        ISBLANK ( Contratos[ctfechafinreal] ) = TRUE ()
			                            || Contratos[ctfechafinreal] >= [fecfin],
			                        [fecfin],
			                        Contratos[ctfechafinreal]
			                    )
			            ),
			            FILTER ( Contratos, Contratos[ctfechaini] <= [fecfin] ),
			            FILTER (
			                Contratos,
			                ISBLANK ( Contratos[ctfechafinreal] ) = TRUE ()
			                    || Contratos[ctfechafinreal] >= [fecini]
			            )
			        ),
			        DIVIDE ( ( DATEDIFF ( [fini], [ffin], DAY ) + 1 ), 7 ) * Contratos[cthorassemana]
			    )
			RETURN
			    result
			
			```
		formatString: #,0.00
		lineageTag: b7112756-4172-4130-93a4-d5ce8695adf0

		changedProperty = FormatString

