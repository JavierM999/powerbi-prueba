table Calendario
	lineageTag: c690a4c8-6e09-4a37-87c0-3428c200b464

	measure fecini = FIRSTDATE(Calendario[Date])
		formatString: General Date
		lineageTag: 27d7951e-7c97-4e84-b4bb-03f334bd71eb

	measure fecfin = LASTDATE(Calendario[Date])
		formatString: General Date
		lineageTag: 6b6a342a-8ce7-4962-a112-b2a39d1826ff

	measure feciniaa = DATE(YEAR([fecini])-1,MONTH([fecini]),DAY([fecini]))
		formatString: General Date
		lineageTag: 8f395ac5-a85c-453e-8e79-a2842c39ad19

	measure fecfinañan = IF(DAY([fecfin])= 29 && MONTH([fecfin])=2, DATE(YEAR([fecfin])-1,MONTH([fecfin]),DAY([fecfin])-1),DATE(YEAR([fecfin])-1,MONTH([fecfin]),DAY([fecfin])))
		formatString: General Date
		lineageTag: 385e072c-f480-4d0a-b86b-6ec4638f89dd

	measure PeriodoSel = "De " & [fecini] & " A " & [fecfin]
		lineageTag: 61607b71-9fc0-483c-beb8-48d7e3ddea4b

	measure Minanyomes = MIN(Calendario[Año/Mes])
		lineageTag: 96b0c9c8-bff0-4697-84e9-555f9ce72fae

	measure MaxAnyoMes = MAX(Calendario[Año/Mes])
		lineageTag: 4807afd2-2a49-47b0-b20d-13a367eb201b

	measure MesesSel = "De " & [Minanyomes] & " A " & [MaxAnyoMes]
		lineageTag: c62cbdae-a1f8-4cc6-bfc4-70bcd9f30adf

