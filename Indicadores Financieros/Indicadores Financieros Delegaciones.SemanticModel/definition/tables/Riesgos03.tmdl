		source =
				let
				    Source = Sql.Database("10.10.138.5\TEMPORING", "n4db003", [Query="Select 'P' as tipo,cucodigo,cunombre,pelimite as limite,sum(g1.gimpinicial) as importe, MONTH(getdate()) as Mes #(lf) from n4db003.dbo.cncuenta,n4db003.dbo.cngirosc g1,n4db003.dbo.cnperson#(lf) where  cucodigo>='4300000000'#(lf) AND  cucodigo<='4300999999'#(lf) and  g1.gcuentacli=cucodigo#(lf) and g1.gestado='P'#(lf) and not exists (select * from n4db003.dbo.cngirosc g2#(lf)                   Where g2.gano=g1.gano#(lf)                   and g2.gdelegacion=g1.gdelegacion#(lf)                   and g2.gnumbase=g1.gnumbase#(lf)                   and g2.gnumrenov=g1.gnumrel#(lf)                   and g2.gestado='I')#(lf) and pecuenta=cucodigo#(lf) GROUP BY cucodigo,cunombre,pelimite  UNION ALL  Select 'R' as tipo,cucodigo,cunombre,pelimite as limite,sum(g1.gimpinicial) as importe , MONTH(getdate()) as Mes#(lf) from n4db003.dbo.cncuenta,n4db003.dbo.cngirosc g1,n4db003.dbo.cnperson#(lf) where  cucodigo>='4300000000'#(lf) AND  cucodigo<='4300999999'#(lf) and  g1.gcuentacli=cucodigo#(lf) and g1.gestado='E'#(lf) and not exists (select * from n4db003.dbo.cngirosc g2#(lf)                   Where g2.gano=g1.gano#(lf)                   and g2.gdelegacion=g1.gdelegacion#(lf)                   and g2.gnumbase=g1.gnumbase#(lf)                   and g2.gnumrenov=g1.gnumrel#(lf)                   and g2.gestado='I')#(lf) and pecuenta=cucodigo#(lf) GROUP BY cucodigo,cunombre,pelimite  UNION ALL  Select 'I' as tipo,cucodigo,cunombre,pelimite as limite,sum(g1.gimpinicial-g1.gimppagado) as importe , MONTH(getdate()) as Mes#(lf) from n4db003.dbo.cncuenta,n4db003.dbo.cngirosc g1,n4db003.dbo.cnperson#(lf) where  cucodigo>='4300000000'#(lf) AND  cucodigo<='4300999999'#(lf) and  g1.gcuentacli=cucodigo#(lf) and g1.gestado='P'#(lf) and exists (select * from n4db003.dbo.cngirosc g2#(lf)                   Where g2.gano=g1.gano#(lf)                   and g2.gdelegacion=g1.gdelegacion#(lf)                   and g2.gnumbase=g1.gnumbase#(lf)                   and g2.gnumrenov=g1.gnumrel#(lf)                   and g2.gestado='I')#(lf) and pecuenta=cucodigo#(lf) GROUP BY cucodigo,cunombre,pelimite  UNION ALL  Select 'E' as tipo,cucodigo,cunombre,pelimite as limite,sum(gimpinicial-gimppagado) as importe , MONTH(getdate()) as Mes#(lf) from n4db003.dbo.cncuenta,n4db003.dbo.cngirosc,n4db003.dbo.cnperson#(lf) where  cucodigo>='4300000000'#(lf) AND  cucodigo<='4300999999'#(lf) and  gcuentacli=cucodigo#(lf) and (gestado='R' OR gestado='G' OR gestado='F')#(lf) and gtipodoc<>'CO'#(lf) AND gfevtoamd >= getdate() -1 and pecuenta=cucodigo#(lf) GROUP BY cucodigo,cunombre,pelimite  UNION ALL  Select 'P' as tipo,cucodigo,cunombre,pelimite as limite,0 as importe  , MONTH(getdate()) as Mes#(lf) from n4db003.dbo.cncuenta,n4db003.dbo.cnperson#(lf) where pecuenta=cucodigo#(lf) and  cucodigo>='4300000000'#(lf) AND  cucodigo<='4300999999'"])
