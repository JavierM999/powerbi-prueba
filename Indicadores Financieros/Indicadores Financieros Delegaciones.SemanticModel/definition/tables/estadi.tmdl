	measure RankCliCN3 = IF([TotFraCN3],CALCULATE(IF(HASONEVALUE('Pseu Clientes'[clnombre]),RANKX(ALL('Pseu Clientes'[clnombre]),[TotFraCN3]),BLANK())))
		formatString: 0
		lineageTag: 4c8789f2-a158-471c-9f52-34b131d9074e

	measure AcumCliCN3 = IF([TotFraCN3],CALCULATE(IF(HASONEFILTER('Pseu Clientes'[clnombre]),SUMX(TOPN([RankCliCN3],ALL('Pseu Clientes'[clnombre]),[TotFraCN3]),[TotFraCN3]),BLANK())),BLANK())
		formatString: #,0.00
		lineageTag: 0602ca2a-72a7-4e11-a572-cdec8699d26d

	measure %ParetoCliE = IF([TotFraCN3],DIVIDE([AcumCliCN3],CALCULATE([TotFraCN3],ALL('Pseu Clientes'[clnombre]))),BLANK())
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 6ef40b97-2f88-4ad4-8854-b85e63b274f5

	measure 'Top N Pareto' = ```
			
			VAR TopnSele = SELECTEDVALUE('TopN Pareto'[Value])
