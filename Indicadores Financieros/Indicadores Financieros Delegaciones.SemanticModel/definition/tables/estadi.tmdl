	measure 'Top N Pareto no sirve' = ```
			
			VAR TopnSele = SELECTEDVALUE('TopN Pareto'[Value])
			VAR TopCnaetabla = 
			 TOPN(
			            TopnSele,
			            ALLSELECTED('Pseu Clientes'),
			            [%ParetoCliE]
			 )
			 VAR TopCnaeVta =
			CALCULATE(
			    [%ParetoCliE],
			    KEEPFILTERS(
			        TopCnaetabla
			        )
			    )
			VAR OtrasVta =
			CALCULATE(
			    [%ParetoCliE],
			    ALLSELECTED('Pseu Clientes')
			) -
			CALCULATE(
			    [%ParetoCliE],
			    TopCnaetabla
			)
			VAR CnaeAct = SELECTEDVALUE('Pseu Clientes'[clnombre])
			Return 
			IF(
			    CnaeAct<>"Otros",
			    TopCnaeVta,
			    OtrasVta
			)
			```
