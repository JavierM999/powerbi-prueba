	measure 'Top N Fraestadi' = ```
			
			VAR TopnSele = SELECTEDVALUE('TopN Selecc'[Value])
			VAR TopCnaetabla = 
			 TOPN(
			            TopnSele,
			            ALLSELECTED('Pseu Clientes'),
			            [Fra.Año Act.]
			 )
			 VAR TopCnaeVta =
			CALCULATE(
			    [Fra.Año Act.],
			    KEEPFILTERS(
			        TopCnaetabla
			        )
			    )
			VAR OtrasVta =
			CALCULATE(
			    [Fra.Año Act.],
			    ALLSELECTED('Pseu Clientes')
			) -
			CALCULATE(
			    [Fra.Año Act.],
			    TopCnaetabla
			)
			VAR CnaeAct = SELECTEDVALUE('Pseu Clientes'[clnombre])
			Return 
			IF(
			    CnaeAct<>"Otros",
			    TopCnaeVta,
			    OtrasVta
			)
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: e4019224-d851-41ed-8c57-b0ba9ab4fa00

		changedProperty = FormatString

	measure RankCli =
			
			IF(
			    [Top N Fraestadi]<>BLANK(),
			    RANKX(
			        TOPN(
			            SELECTEDVALUE('TopN Selecc'[Value]),
			            ALLSELECTED('Pseu Clientes'),
			            [Fra.Año Act.]
			        ),
			        [Fra.Año Act.],,DESC,Dense
			        )
			)
		formatString: 0
		lineageTag: c6b727ac-d3b7-4d7e-b434-0ab353d1f6cb

