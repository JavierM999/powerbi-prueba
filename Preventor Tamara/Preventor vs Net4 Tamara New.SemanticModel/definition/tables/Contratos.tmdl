			```
		formatString: 0
		lineageTag: 4a3517d0-0f4e-4b64-b2ee-c0314a647ce8

	measure Altas = CALCULATE(COUNTROWS(Contratos),FILTER(Contratos,Contratos[ctfechaini]>=[fecini]),FILTER(Contratos,Contratos[ctfechaini]<=[fecfin]))
		formatString: 0
		lineageTag: b1725d94-356d-417d-988f-da73300832f7

	measure TotTRaAlt = ```
			
			    CALCULATE (
			        DISTINCTCOUNT(Contratos[cttrabajador]),
			        FILTER ( ALL ( contratos[ctfechaini] ), Contratos[ctfechaini] >= [fecini] ),
			        FILTER (
			            ALL ( contratos[ctfechaini] ),  Contratos[ctfechaini] <= [fecfin]
			        )
			    )
			```
		formatString: 0
		lineageTag: 4f9747a1-40b2-4ffa-8cbf-8b508bf13bc4

	measure 'Novac OKAS' =
			
			SUMX (
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE (
			                DocContratos,
			                MCANCentros[Texto],
			                DocContratos[DetCCenCon],
			                DocContratos[dodescripcion]
			            ),
			            "DTROK", IF ( CONTAINSSTRING ( DocContratos[dodescripcion], "novación" ), 1 )
			        ),
			        FILTER (
			            ALL ( DocContratos[ctfechaini] ),
			            DocContratos[ctfechaini] <= [fecfin]
			        ),
			        FILTER (
			            ALL ( DocContratos[ctfechafinreal] ),
			            ISBLANK ( DocContratos[ctfechafinreal] ) = TRUE ()
			                || DocContratos[ctfechafinreal] >= [fecini]
			        ),
			        FILTER (
			            ALL ( DocContratos[CFacftipacc] ),
			            DocContratos[CFacftipacc] = "FIEMP"
			        )
			    ),
			    [DTROK]
			)
		formatString: 0
		lineageTag: 2f25d430-5ff4-4605-8c1f-01f1b7f17c3e

	measure 'Novac OKAL' = ```
			
			SUMX (
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE (
			                DocContratos,
			                MCANCentros[Texto],
			                DocContratos[DetCCenCon],
			                DocContratos[dodescripcion]
			            ),
			            "DTROK", IF ( CONTAINSSTRING ( DocContratos[dodescripcion], "novación" ), 1 )
			        ),
			         FILTER ( ALL(DocContratos[ctfechaini]) , DocContratos[ctfechaini] >= [fecini]  && DocContratos[ctfechaini] <= [fecfin] 
			    ),
			        FILTER (
			            ALL ( DocContratos[CFacftipacc] ),
			            DocContratos[CFacftipacc] = "FIEMP"
			        )
			    ),
			    [DTROK]
			)
			```
		formatString: 0
		lineageTag: eae12880-a30e-4187-b728-014145d36552

	measure Oculta = IF(SELECTEDVALUE(Opciones[Texto])="ASIGNACIONES",1,0)
		formatString: 0
		lineageTag: 47b56a5b-cb7d-426f-a290-907c4c2e3bbb

	measure NFPRLAL = ```
			
			CALCULATE(
			    DISTINCTCOUNT(Contratos[CTCenCon]),  
			    FILTER(
			        'Contratos',  -- Filtrar la tabla de contratos
			        [Altas] = 1 &&  -- El contrato está activo en el período seleccionado
			        TREATAS(
			            SELECTCOLUMNS(
			            FILTER(
			                'FormPRL',
			                FormPRL[CodTrab] = Contratos[cttrabajador] &&  -- Misma persona
			                FormPRL[dofecha] <= [fecfin] &&  -- Fecha de realización anterior o igual al último día del mes/año seleccionado
			                FormPRL[Validez] >= [fecini] &&  -- Fecha de fin de validez posterior o igual al primer día del mes/año seleccionado
			                FormPRL[acftipacc]="FIEMP"
			            ),
			            FormPRL[CodTrab]),
			            Contratos[cttrabajador]
			        )
			    )
			)
			```
		formatString: 0
		lineageTag: 7d41ad42-72e2-4846-b892-42de8c9608ea

	measure NFPRLAS = ```
			
			CALCULATE(
			    DISTINCTCOUNT(Contratos[CTCenCon]),  
			    FILTER(
			        'Contratos',  -- Filtrar la tabla de contratos
			        [Asignaciones] = 1 &&  -- El contrato está activo en el período seleccionado
			        TREATAS(
			            SELECTCOLUMNS(
			            FILTER(
			                'FormPRL',
			                FormPRL[CodTrab] = Contratos[cttrabajador] &&  -- Misma persona
			                FormPRL[dofecha] <= [fecfin] &&  -- Fecha de realización anterior o igual al último día del mes/año seleccionado
			                FormPRL[Validez] >= [fecini] &&  -- Fecha de fin de validez posterior o igual al primer día del mes/año seleccionado
			                FormPRL[acftipacc] = "FIEMP"
			            ),
			            FormPRL[CodTrab]),
			            Contratos[cttrabajador]
			        )
			    )
			)
			```
		formatString: 0
		lineageTag: 41faa2a6-b979-4be2-94a8-758a2e76baa8

