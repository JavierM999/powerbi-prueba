table Contratos
	lineageTag: 839b09ee-e9c6-433c-aca3-c874436bad68

	measure Asignaciones = ```
			
			    CALCULATE (
			        COUNTROWS ( Contratos ),
			        FILTER ( ALL ( contratos[ctfechaini] ), Contratos[ctfechaini] <= [fecfin] ),
			        FILTER (
			            ALL ( contratos[ctfechafinreal] ),
			            ISBLANK ( Contratos[ctfechafinreal] ) = TRUE ()
			                || Contratos[ctfechafinreal] >= [fecini]
			        )
			    )
			```
		formatString: 0
		lineageTag: 05037190-3f55-4a55-ba18-9f717cd4be3f

	measure TotTra = ```
			DISTINCTCOUNT(Contratos[cttrabajador]) 
			```
		formatString: 0
		lineageTag: d77e0205-6f4b-4831-be1b-877effeb3759

	measure TotTRaAct = ```
			
			    CALCULATE (
			        DISTINCTCOUNT(Contratos[cttrabajador]),
			        FILTER ( ALL ( contratos[ctfechaini] ), Contratos[ctfechaini] <= [fecfin] ),
			        FILTER (
			            ALL ( contratos[ctfechafinreal] ),
			            ISBLANK ( Contratos[ctfechafinreal] ) = TRUE ()
			                || Contratos[ctfechafinreal] >= [fecini]
			        )
