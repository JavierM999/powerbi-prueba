			)
		lineageTag: d3de4cb3-7572-41b6-99c0-fb94869a354e

	measure 'Tiene Curso Aplicable' =
			
			VAR _Trabajador = SELECTEDVALUE ( Contratos[cttrabajador] )
			VAR _IniContrato = SELECTEDVALUE ( Contratos[ctfechaini] )
			VAR _FinContrato =
			    COALESCE (
			        SELECTEDVALUE ( Contratos[ctfechafinreal] ),
			        [fecfin]
			    )
			VAR _NumCursos =
			    CALCULATE (
			        COUNTROWS ( CursoXTrab ),
			        FILTER (
			            CursoXTrab,
			            CursoXTrab[pcttrabajador] = _Trabajador
			                && CursoXTrab[pctfechaini] <= _FinContrato
			                && EDATE (
			                    CursoXTrab[pctfechafin],
			                    COALESCE ( RELATED ( Cursos[pccaducidad] ), 0 ) * 12
			                ) >= _IniContrato
			        )
			    )
			RETURN
			IF ( _NumCursos > 0, "Sí", BLANK () )
		lineageTag: f2be2284-0fa1-462b-905e-0155bf39acb8

	measure 'Cursos Aplicables Contrato' =
			
			VAR _Trabajador = SELECTEDVALUE ( Contratos[cttrabajador] )
			VAR _IniContrato = SELECTEDVALUE ( Contratos[ctfechaini] )
			VAR _FinContrato =
			    COALESCE ( SELECTEDVALUE ( Contratos[ctfechafinreal] ), [fecfin] )
			VAR _Cursos =
			    FILTER (
			        ALL ( CursoXTrab ),
			        CursoXTrab[pcttrabajador] = _Trabajador
			            && CursoXTrab[pctfechaini] <= _FinContrato
			            && CursoXTrab[FechaCaducidad] >= _IniContrato
			    )
			RETURN
			IF (
			    HASONEVALUE ( Contratos[ctcontrato] )
			        && NOT ISBLANK ( _Trabajador )
			        && NOT ISBLANK ( _IniContrato ),
			    CONCATENATEX (
			        _Cursos,
			        CursoXTrab[CursoDetalle],
			        ", ",
			        CursoXTrab[pctfechaini],
			        ASC
			    )
			)
		lineageTag: cc4c4261-637f-4d14-8572-1754c5c06a4c

	measure 'Nombre y Codigo Cursos Aplicables' =
			
			VAR _Trabajador = SELECTEDVALUE ( Contratos[cttrabajador] )
			VAR _IniContrato = SELECTEDVALUE ( Contratos[ctfechaini] )
			VAR _FinContrato =
			    COALESCE (
			        SELECTEDVALUE ( Contratos[ctfechafinreal] ),
			        [fecfin]
			    )
			VAR _CursosAplicables =
			    FILTER (
			        CursoXTrab,
			        CursoXTrab[pcttrabajador] = _Trabajador
			            && CursoXTrab[pctfechaini] <= _FinContrato
			            && EDATE (
			                CursoXTrab[pctfechafin],
			                COALESCE ( RELATED ( Cursos[pccaducidad] ), 0 ) * 12
			            ) >= _IniContrato
			    )
			RETURN
			IF (
			    HASONEVALUE ( Contratos[ctcontrato] ),
			    CONCATENATEX (
			        _CursosAplicables,
			        CursoXTrab[pctcurso] & " - " & RELATED ( Cursos[pcnombre] ),
			        ", ",
			        CursoXTrab[pctcurso],
			        ASC
			    )
			)
		lineageTag: d9b24529-19c5-4082-8e6d-07b5a192ade4

	measure 'Cursos Aplicables Resumen' =
			
			VAR _Trabajador = SELECTEDVALUE ( Contratos[cttrabajador] )
			VAR _IniContrato = SELECTEDVALUE ( Contratos[ctfechaini] )
			VAR _FinContrato =
			    COALESCE ( SELECTEDVALUE ( Contratos[ctfechafinreal] ), [fecfin] )
			RETURN
			IF (
			    HASONEVALUE ( Contratos[ctcontrato] )
			        && NOT ISBLANK ( _Trabajador )
			        && NOT ISBLANK ( _IniContrato ),
			    CALCULATE (
			        CONCATENATEX (
			            FILTER (
			                ALL ( CursoXTrab ),
			                CursoXTrab[pcttrabajador] = _Trabajador
			                    && CursoXTrab[pctfechaini] <= _FinContrato
			                    && CursoXTrab[FechaCaducidad] >= _IniContrato
			            ),
			            CursoXTrab[pctcurso]
			                & " - "
			                & RELATED ( Cursos[pcnombre] )
			                & " | inicio: "
			                & FORMAT ( CursoXTrab[pctfechaini], "dd/MM/yyyy" )
			                & " | caduca: "
			                & FORMAT ( CursoXTrab[FechaCaducidad], "dd/MM/yyyy" ),
			            ", ",
			            CursoXTrab[pctfechaini],
			            ASC
			        )
			    )
			)
		lineageTag: 3a948134-15cc-4d90-b759-bac1940123a1

	measure 'Categoria Cursos Trabajador' =
			
			VAR _Trabajador = SELECTEDVALUE ( Contratos[cttrabajador] )
			RETURN
			IF (
			    HASONEVALUE ( Contratos[cttrabajador] ),
			    CALCULATE (
			        CONCATENATEX (
			            VALUES ( CursoXTrab[pctcategoria] ),
			            CursoXTrab[pctcategoria],
			            ", ",
			            CursoXTrab[pctcategoria],
			            ASC
			        ),
			        TREATAS ( { _Trabajador }, CursoXTrab[pcttrabajador] )
			    )
			)
		lineageTag: 668a925b-ce39-4780-a056-f719a126165a

	measure 'Nombre Categorias Aplicables' =
			
			VAR _Trabajador = SELECTEDVALUE ( Contratos[cttrabajador] )
			VAR _IniContrato = SELECTEDVALUE ( Contratos[ctfechaini] )
			VAR _FinContrato =
			    COALESCE ( SELECTEDVALUE ( Contratos[ctfechafinreal] ), [fecfin] )
			RETURN
			IF (
			    HASONEVALUE ( Contratos[ctcontrato] )
			        && NOT ISBLANK ( _Trabajador )
			        && NOT ISBLANK ( _IniContrato ),
			    CALCULATE (
			        CONCATENATEX (
			            DISTINCT (
			                SELECTCOLUMNS (
			                    FILTER (
			                        ALL ( CursoXTrab ),
			                        CursoXTrab[pcttrabajador] = _Trabajador
			                            && CursoXTrab[pctfechaini] <= _FinContrato
			                            && CursoXTrab[FechaCaducidad] >= _IniContrato
			                    ),
			                    "NombreCategoria", RELATED ( Categorias[canombre] )
			                )
			            ),
			            [NombreCategoria],
			            ", ",
			            [NombreCategoria],
			            ASC
			        )
			    )
			)
		lineageTag: 6cd928c4-e65a-46c8-bb9e-c1eb0329b10f

