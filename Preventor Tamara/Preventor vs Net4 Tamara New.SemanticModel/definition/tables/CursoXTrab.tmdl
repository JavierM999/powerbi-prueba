	measure 'TotCur AsTrabaj' =
			
			IF (
			    [TotTRaAct],
			    CALCULATE (
			        DISTINCTCOUNT ( CursoXTrab[pcttrabajador] ),
			        FILTER (
			            CursoXTrab,
			            CursoXTrab[pcttrabajador] IN VALUES ( Contratos[cttrabajador] )
			        ),
			        FILTER ( CursoXTrab, CursoXTrab[pctcontralab] = 0 )
			    ),
			    BLANK ()
			)
		formatString: 0
		lineageTag: abf336e2-99e7-4e56-8eda-be2074d76514

	measure 'Tot TraCurso2' = ```
			
			   IF (
			    [TotTRaAct],
			    CALCULATE (
			        COUNTROWS ( CursoXTrab ),
			        FILTER (
			            CursoXTrab,
			            CursoXTrab[pctfechafin]
			                >= DATE ( YEAR ( TODAY () ) - 1, MONTH ( TODAY () ), DAY ( TODAY () ) )
			        )
			    ),
			    BLANK ()
			)
			```
		formatString: 0
		lineageTag: 607e2428-c8d5-4834-9138-26dc9213e57a

	measure 'Cursos Trabajador' =
			
			VAR _Trabajador = SELECTEDVALUE ( Trabajador[cttrabajador] )
			RETURN
			IF (
			    NOT ISBLANK ( _Trabajador ),
			    CALCULATE (
			        CONCATENATEX (
			            DISTINCT ( CursoXTrab[pctcurso] ),
			            CursoXTrab[pctcurso],
			            ", "
			        ),
			        FILTER (
			            ALL ( CursoXTrab ),
			            CursoXTrab[pcttrabajador] = _Trabajador
			        )
			    )
			)
		lineageTag: 143f5a94-166f-471f-986f-cd2521ed16d9

	measure 'Cursos Trabajador Activo' =
			
			VAR _Trabajador = SELECTEDVALUE ( Contratos[cttrabajador] )
			RETURN
			IF (
			    HASONEVALUE ( Contratos[cttrabajador] ),
			    CALCULATE (
			        CONCATENATEX (
			            VALUES ( CursoXTrab[pctcurso] ),
			            CursoXTrab[pctcurso],
			            ", ",
			            CursoXTrab[pctcurso],
			            ASC
			        ),
			        TREATAS ( { _Trabajador }, CursoXTrab[pcttrabajador] )
			    )
			)
		lineageTag: ee142d43-7b92-4598-8c58-014cc3ec4c40

	measure 'Cursos Trabajador Detalle' =
			
			VAR _Trabajador = SELECTEDVALUE ( Contratos[cttrabajador] )
			RETURN
			IF (
			    HASONEVALUE ( Contratos[cttrabajador] ),
			    CALCULATE (
			        CONCATENATEX (
			            CursoXTrab,
			            CursoXTrab[pctcurso]
			                & " ("
			                & FORMAT ( CursoXTrab[pctfechaini], "dd/MM/yyyy" )
			                & " - "
			                & FORMAT ( CursoXTrab[pctfechafin], "dd/MM/yyyy" )
			                & ")",
			            ", ",
			            CursoXTrab[pctfechaini],
			            ASC
			        ),
			        TREATAS ( { _Trabajador }, CursoXTrab[pcttrabajador] )
			    )
			)
		lineageTag: a120837f-e3ed-4718-88f2-ebd2f93a4552

	measure 'Caducidad Cursos Detalle' =
			
			VAR _Trabajador = SELECTEDVALUE ( Contratos[cttrabajador] )
			RETURN
			IF (
			    HASONEVALUE ( Contratos[cttrabajador] ),
			    CALCULATE (
			        CONCATENATEX (
			            CursoXTrab,
			            CursoXTrab[pctcurso]
			                & " caduca el "
			                & FORMAT (
			                    EDATE (
			                        CursoXTrab[pctfechafin],
			                        RELATED ( Cursos[pccaducidad] ) * 12
			                    ),
			                    "dd/MM/yyyy"
			                ),
			            ", ",
			            CursoXTrab[pctfechafin],
			            ASC
			        ),
			        TREATAS ( { _Trabajador }, CursoXTrab[pcttrabajador] )
			    )
			)
		lineageTag: e42e6161-d77a-48ca-aabf-42d80581884e

	measure 'Nombre y Codigo Cursos Trabajador' =
			
			VAR _Trabajador = SELECTEDVALUE ( Contratos[cttrabajador] )
			RETURN
			IF (
			    HASONEVALUE ( Contratos[cttrabajador] ),
			    CALCULATE (
			        CONCATENATEX (
			            CursoXTrab,
			            CursoXTrab[pctcurso] & " - " & RELATED ( Cursos[pcnombre] ),
			            ", ",
