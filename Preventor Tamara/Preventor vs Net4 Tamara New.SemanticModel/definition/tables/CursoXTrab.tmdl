	column FechaCaducidad =
			
			VAR _Anios = COALESCE ( RELATED ( Cursos[pccaducidad] ), 0 )
			RETURN
			IF (
			    NOT ISBLANK ( CursoXTrab[pctfechafin] ),
			    EDATE ( CursoXTrab[pctfechafin], _Anios * 12 )
			)
		formatString: General Date
		lineageTag: 65b16c29-1a07-4d26-a1ac-7b4b6d6644dd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

